# Python / environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Data, models and generated files stay on the laptop. The dataset is Sensei's store
# footage and must never be published; everything else is regenerated by the CLI.
data/*
!data/labels/
cache/
models/
outputs/
backups/
labeling/
experiments/

# Large binaries
*.zip
*.tar.gz
*.npz
*.npy
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# Images: frames, crops and screenshots all show the store
*.jpg
*.jpeg
*.png
*.webp
pitch/slides_standalone.html

# API keys (never commit)
gemini_key.txt
*.key
.env

# Team working notes (not for the public repo)
docs/ines_todo.md
docs/TODO_FOR_TEAM.md
docs/morning_summary.md

# PDFs exported from the deck contain store photos (local only)
pitch/*.pdf
docs/lovable_prompt.md

# Team logo (our own artwork, not store data)
!brand/*.png

# Sensei team password for the encrypted demo (never publish)
docs/team_password.txt

# Generated outputs and media (never published)
submission/
*.pdf
*.mp4
*.webm
*.mov
*.pptx
# Junction form paste helper (local)
docs/junction_form.*
